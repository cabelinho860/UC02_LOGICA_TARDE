programa{
    funcao inicio() {
        real dinheiro
        logico estudante = falso

        escreva("qual o valor total da compra? ")
    leia(dinheiro)
   
   se(dinheiro >= 50.00 ou estudante =| verdadeiro )
    {
     escreva("vocé recebeu o valor promocional")
    }
    senao
    {
        escreva("vocé não recebeu o valor promocional")
    }    
    }

}