programa{
    funcao inicio() {
        real idade
        logico carteira = falso

        escreva("qual a idade do torcedor? ")
    leia(idade)
   
   se(idade <= 12 ou carteira = falso )
    {
     escreva("vocé ganhou o beneficio")
    }
    senao 
    {
        escreva("vocé não recebeu o beneficio")
    }    
    }
} 