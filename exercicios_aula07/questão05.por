programa{
    funcao inicio() {
        real altura
        logico noite = falso
        escreva(" qual a altura atual da maré?")
    leia(altura)
   
   se( altura <= 0.2 ou noite = falso  )
    {
     escreva("vocé vai pode entra na maré")
    }
    senao 
    {
        escreva("vocé não vai pode entra na maré!")
    }    
    }
}