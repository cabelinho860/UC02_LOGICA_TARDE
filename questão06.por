programa{
    funcao inicio() {
        real nota
        real frequencia
        escreva("Qual a media geral do aluno? ")
    leia(nota)
    escreva("Qual e a frequencia e porcentagem:")
   leia (frequencia)
   se(nota <= 8 e frequencia <= 75  )
    {
     escreva("parabens pela dedicação nos estudos")
    }
    senao 
    {
        escreva(" vocé não passou ")
    }    
    }
}